{
  "name": "dsh-plugin-screenshot-tool",
  "version": "1.0.1",
  "description": "WeChat-style screenshot button in the DeepSeek Harness composer: native macOS region capture (optionally hiding the window), copied to the clipboard and inserted into the composer as a draft attachment.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "screenshot",
    "screen-capture",
    "macos",
    "composer",
    "clipboard"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.2-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haonan108/dsh-plugin-screenshot-tool.git"
  },
  "homepage": "https://github.com/haonan108/dsh-plugin-screenshot-tool#readme",
  "bugs": {
    "url": "https://github.com/haonan108/dsh-plugin-screenshot-tool/issues"
  }
}
